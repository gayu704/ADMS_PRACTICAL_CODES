SET SERVEROUTPUT ON;

DECLARE
    N NUMBER := 153;
    TEMP NUMBER;
    DIGIT NUMBER;
    SUM NUMBER := 0;
BEGIN
    TEMP := N;

    WHILE TEMP > 0 LOOP
        DIGIT := MOD(TEMP,10);
        SUM := SUM + (DIGIT * DIGIT * DIGIT);
        TEMP := TRUNC(TEMP/10);
    END LOOP;

    IF SUM = N THEN
        DBMS_OUTPUT.PUT_LINE(N || ' IS AN ARMSTRONG NUMBER');
    ELSE
        DBMS_OUTPUT.PUT_LINE(N || ' IS NOT AN ARMSTRONG NUMBER');
    END IF;
END;
/
