Aggregate Functions
SELECT COUNT(*) AS TOTAL_STUDENTS
FROM STUDENT;

SELECT SUM(MARK) AS TOTAL_MARK
FROM STUDENT;

SELECT AVG(MARK) AS AVERAGE_MARK
FROM STUDENT;

SELECT MAX(MARK) AS MAXIMUM_MARK
FROM STUDENT;

SELECT MIN(MARK) AS MINIMUM_MARK
FROM STUDENT;
