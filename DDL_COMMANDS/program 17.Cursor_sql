DECLARE
    CURSOR C1 IS
        SELECT ID, NAME, MARK FROM STUDENT;

    V_ID STUDENT.ID%TYPE;
    V_NAME STUDENT.NAME%TYPE;
    V_MARK STUDENT.MARK%TYPE;
BEGIN
    OPEN C1;

    LOOP
        FETCH C1 INTO V_ID, V_NAME, V_MARK;
        EXIT WHEN C1%NOTFOUND;

        DBMS_OUTPUT.PUT_LINE(V_ID || ' ' || V_NAME || ' ' || V_MARK);
    END LOOP;

    CLOSE C1;
END;
