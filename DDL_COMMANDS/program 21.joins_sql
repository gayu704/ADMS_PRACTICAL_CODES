CREATE TABLE DEPARTMENT (
    DEPT_ID NUMBER,
    DEPT_NAME VARCHAR2(20)
);

CREATE TABLE STUDENT (
    ID NUMBER,
    NAME VARCHAR2(20),
    DEPT_ID NUMBER
);
Insert values
INSERT INTO DEPARTMENT VALUES (1, 'COMPUTER');
INSERT INTO DEPARTMENT VALUES (2, 'SCIENCE');

INSERT INTO STUDENT VALUES (101, 'GAYATHRI', 1);
INSERT INTO STUDENT VALUES (102, 'PRIYA', 2);
INSERT INTO STUDENT VALUES (103, 'DIVYA', 1);

COMMIT;
INNER JOIN
SELECT S.ID, S.NAME, D.DEPT_NAME
FROM STUDENT S
INNER JOIN DEPARTMENT D
ON S.DEPT_ID = D.DEPT_ID;
